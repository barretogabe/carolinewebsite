{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [

    {
      "source": "/fisioterapia-:slug",
      "destination": "/#especialidades",
      "permanent": false
    },
    {
      "source": "/pilates-janga",
      "destination": "/#estudio",
      "permanent": false
    },
    {
      "source": "/pilates-para-eventos",
      "destination": "/#especialidades",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
